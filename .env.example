# Chat: required for the first real model request.
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-name

# Optional: configure only when reaching the real Embedding lessons.
# DASHSCOPE_API_KEY=your-dashscope-api-key
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_MODEL=text-embedding-v2
# EMBEDDING_DIMENSIONS=1536

# Default mode: no database needed for entry-level lessons.
ORDER_STORAGE_BACKEND=demo
KNOWLEDGE_RETRIEVAL_BACKEND=ngram

# Optional: Docker/PostgreSQL chapters. Use a password for your own local instance.
POSTGRES_HOST=localhost
POSTGRES_PORT=25432
POSTGRES_DB=agent_learning
POSTGRES_USER=learner
POSTGRES_PASSWORD=choose-a-local-password

# Vector database chapter: uncomment these and replace the earlier model selection.
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1536
PGVECTOR_TOP_K=3
PGVECTOR_MIN_SCORE=0.5
